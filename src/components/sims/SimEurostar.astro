---
interface Props {
  height?: string;
}

const { height = '560px' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="sim-block">
  <div class="sim-wrapper" style={`height: ${height}`}>
    <!-- Site token header -->
    <div class="sim-header">
      <div class="sim-header-content">
        <div class="sim-title">Eurostar Network</div>
        <div class="sim-subtitle">European HSR — London, Paris, Brussels, Amsterdam — Tech-Twin</div>
      </div>
      <a href={`${base}/sims/eurostar/`} class="sim-fullscreen-link">
        Open fullscreen &rarr;
      </a>
    </div>

    <!-- Iframe embed -->
    <iframe
      src={`${base}/sims/eurostar/index.html`}
      title="Eurostar Network Simulation"
      class="sim-iframe"
      style="height: 100%;"
      loading="lazy"
      sandbox="allow-scripts allow-same-origin allow-forms allow-modals"
    ></iframe>
  </div>
  <p class="sim-desc">European high-speed rail network — live train movements between London, Paris, Brussels and Amsterdam, rendered in Three.js with real route geometry and scenario simulation.</p>
</div>

<style>
  .sim-block {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sim-wrapper {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-bottom: none;
    background: var(--surface);
  }

  .sim-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas);
    gap: 16px;
    flex-shrink: 0;
  }

  .sim-header-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sim-title {
    font-family: var(--display);
    font-size: 20px;
    font-style: italic;
    color: var(--ink);
    line-height: 1;
  }

  .sim-subtitle {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  .sim-fullscreen-link {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .sim-fullscreen-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .sim-iframe {
    flex: 1;
    width: 100%;
    border: none;
    display: block;
  }

  .sim-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.55;
    padding: 14px 18px;
    border: 1px solid var(--hairline);
    border-top: none;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--canvas);
    margin: 0;
  }
</style>
