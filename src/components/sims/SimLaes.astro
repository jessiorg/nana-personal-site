---
interface Props {
  height?: string;
}

const { height = '560px' } = Astro.props;
---

<div class="sim-wrapper" style={`height: ${height}`}>
  <!-- Site token header -->
  <div class="sim-header">
    <div class="sim-header-content">
      <div class="sim-title">LAES Energy Storage</div>
      <div class="sim-subtitle">Liquid Air Energy Storage — grid-scale long-duration simulation</div>
    </div>
    <a href="/sims/laes/" class="sim-fullscreen-link">
      Open fullscreen &rarr;
    </a>
  </div>

  <!-- Iframe embed — sim Laes is a self-contained HTML file in /public -->
  <iframe
    src="/sims/laes/index.html"
    title="LAES Energy Storage Simulation"
    class="sim-iframe"
    loading="lazy"
    sandbox="allow-scripts allow-same-origin allow-forms"
  ></iframe>
</div>

<style>
  .sim-wrapper {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--surface);
  }

  .sim-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas);
    gap: 16px;
    flex-shrink: 0;
  }

  .sim-header-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sim-title {
    font-family: var(--display);
    font-size: 20px;
    font-style: italic;
    color: var(--ink);
    line-height: 1;
  }

  .sim-subtitle {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  .sim-fullscreen-link {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .sim-fullscreen-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .sim-iframe {
    flex: 1;
    width: 100%;
    border: none;
    display: block;
  }
</style>
