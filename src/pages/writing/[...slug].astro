---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const essays = await getCollection('writing');
  return essays.map(essay => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await essay.render();
---

<BaseLayout
  title={`${essay.data.title} — Nana Gyasi`}
  description={essay.data.dek}
>
  <NavBar currentPath={`${base}/writing`} />

  <main id="content">
    <article class="article">

      <!-- Back -->
      <nav class="article-back wrap">
        <a href={`${base}/writing/`} class="back-link">
          <span>←</span> All essays
        </a>
      </nav>

      <!-- Header -->
      <header class="article-header wrap">
        <div class="article-kicker">
          <span class="kicker-rule" />
          <span class="kicker-text">{essay.data.eyebrow}</span>
        </div>
        <h1 class="article-title">{essay.data.title}</h1>
        <p class="article-lede">{essay.data.dek}</p>

        <!-- FT-style rule with dot -->
        <div class="ft-rule">
          <div class="ft-rule-line" />
          <div class="ft-rule-dot" />
          <div class="ft-rule-line" />
        </div>
      </header>

      <!-- Body -->
      <div class="article-body wrap prose">
        <Content />
      </div>

      <!-- Ornamental close -->
      <div class="wrap">
        <div class="ornament">
          <span>· · ·</span>
        </div>
      </div>

      <!-- Ref card -->
      <div class="article-ref wrap">
        <div class="ref-inner">
          <span class="ref-label">See this in context</span>
          <a href={`${base}${essay.data.refHref}`} class="ref-link">
            {essay.data.ref}
          </a>
        </div>
      </div>

      <!-- Back to writing -->
      <nav class="article-back-bottom wrap">
        <a href={`${base}/writing/`} class="back-link">
          <span>←</span> All essays
        </a>
      </nav>

    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  // GSAP entrance animations
  const script = document.createElement('script');
  script.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js';
  script.onload = () => {
    const st = document.createElement('script');
    st.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js';
    st.onload = () => {
      (gsap as any).registerPlugin((gsap as any).ScrollTrigger);

      // Hero stagger
      (gsap as any).from('.article-kicker', { opacity: 0, x: -16, duration: 0.5, ease: 'power2.out' });
      (gsap as any).from('.article-title', { opacity: 0, y: 32, duration: 0.85, delay: 0.1, ease: 'power2.out' });
      (gsap as any).from('.article-lede', { opacity: 0, y: 20, duration: 0.65, delay: 0.25, ease: 'power2.out' });
      (gsap as any).from('.ft-rule', { opacity: 0, scaleX: 0, duration: 0.6, delay: 0.4, ease: 'power2.out', transformOrigin: 'center' });

      // Body content reveal
      document.querySelectorAll('.article-body h2, .article-body p, .article-body blockquote, .article-body ul, .article-body ol').forEach((el) => {
        (gsap as any).from(el, {
          scrollTrigger: { trigger: el, start: 'top 90%', once: true },
          opacity: 0, y: 20, duration: 0.6, ease: 'power2.out',
        });
      });
    };
    document.head.appendChild(st);
  };
  document.head.appendChild(script);
</script>

<style>
  /* ======== BACK LINK ======== */
  .article-back {
    padding-top: 48px;
    padding-bottom: 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .back-link:hover {
    color: var(--ink);
  }

  /* ======== HEADER ======== */
  .article-header {
    padding-top: 40px;
    padding-bottom: 0;
  }

  .article-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .kicker-rule {
    display: block;
    width: 32px;
    height: 2px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .kicker-text {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .article-title {
    font-family: var(--display);
    font-size: clamp(36px, 5.5vw, 64px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 24px;
    max-width: 20ch;
  }

  .article-lede {
    font-size: 20px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 48px;
    font-style: italic;
  }

  /* FT-style rule */
  .ft-rule {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 0;
  }
  .ft-rule-line {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }
  .ft-rule-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* ======== BODY ======== */
  .article-body {
    padding-top: 56px;
    padding-bottom: 0;
  }

  /* ======== PROSE STYLES ======== */
  .prose {
    font-size: 18px;
    line-height: 1.78;
    color: var(--ink);
  }

  /* Drop cap */
  .prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--display);
    font-size: 76px;
    line-height: 0.82;
    padding-right: 10px;
    padding-top: 6px;
    color: var(--accent);
    font-weight: 400;
  }

  .prose p {
    margin: 0 0 1.5em;
    max-width: 65ch;
  }

  .prose h2 {
    font-family: var(--display);
    font-size: clamp(22px, 3vw, 30px);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    margin: 2.4em 0 0.7em;
  }

  .prose blockquote {
    margin: 2em 0;
    padding: 0 0 0 20px;
    border-left: 2px solid var(--accent);
    font-size: 20px;
    line-height: 1.6;
    font-style: italic;
    color: var(--ink);
  }

  .prose blockquote p {
    margin: 0;
  }

  .prose ul, .prose ol {
    margin: 0 0 1.5em 1.5em;
    padding: 0;
  }

  .prose li {
    margin-bottom: 0.4em;
  }

  .prose a {
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .prose a:hover {
    border-color: transparent;
  }

  /* ======== REF CARD ======== */
  .article-ref {
    padding-top: 0;
    padding-bottom: 0;
  }
  .ref-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .ref-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ref-link {
    font-family: var(--display);
    font-size: 20px;
    font-style: italic;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .ref-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ======== BACK BOTTOM ======== */
  .article-back-bottom {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  /* ======== RESPONSIVE ======== */
  @media (max-width: 640px) {
    .article-back { padding-top: 32px; }
    .article-header { padding-top: 28px; }
    .article-title { font-size: clamp(30px, 8vw, 48px); }
    .article-lede { font-size: 17px; margin-bottom: 32px; }
    .article-body { padding-top: 40px; }
    .prose { font-size: 16px; line-height: 1.72; }
    .prose > p:first-of-type::first-letter { font-size: 56px; }
    .prose blockquote { font-size: 17px; }
    .ref-inner { flex-direction: column; align-items: flex-start; gap: 12px; }
    .article-back-bottom { padding-bottom: 56px; }
  }

  @media (max-width: 480px) {
    .article-back { padding-top: 24px; }
    .article-title { font-size: 28px; }
    .kicker-rule { width: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-kicker,
    .article-title,
    .article-lede,
    .ft-rule {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
