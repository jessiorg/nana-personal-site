---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const essays = await getCollection('writing');
  return essays.map(essay => ({
    params: { slug: essay.slug },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await essay.render();
---

<BaseLayout
  title={`${essay.data.title} — Nana Gyasi`}
  description={essay.data.dek}
>
  <NavBar currentPath="/writing" />

  <main id="content">
    <article class="article">
      <!-- Back link -->
      <nav class="article-back">
        <a href={`${base}/#writing`} class="back-link">
          <span class="back-arrow">←</span> Writing
        </a>
      </nav>

      <!-- Header -->
      <header class="article-header">
        <div class="eyebrow">{essay.data.eyebrow}</div>
        <h1 class="article-title">{essay.data.title}</h1>
        <p class="article-dek">{essay.data.dek}</p>
        <div class="article-rule"></div>
      </header>

      <!-- Body -->
      <div class="article-body prose">
        <Content />
      </div>

      <!-- Ref card -->
      <div class="ref-card">
        <span class="ref-label">See this in context</span>
        <a href={essay.data.refHref} class="ref-link">
          {essay.data.ref}
        </a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<script>
  // GSAP ScrollTrigger — loaded via CDN
  const script = document.createElement('script');
  script.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js';
  script.onload = () => {
    const stScript = document.createElement('script');
    stScript.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js';
    stScript.onload = () => {
      (gsap as any).registerPlugin((gsap as any).ScrollTrigger);

      // Hero entrance — staggered fade + rise
      (gsap as any).from('.article-header .eyebrow', {
        y: 16, opacity: 0, duration: 0.5, ease: 'power2.out',
      });
      (gsap as any).from('.article-title', {
        y: 36, opacity: 0, duration: 0.8, delay: 0.1, ease: 'power2.out',
      });
      (gsap as any).from('.article-dek', {
        y: 20, opacity: 0, duration: 0.6, delay: 0.25, ease: 'power2.out',
      });
      (gsap as any).from('.article-rule', {
        scaleX: 0, transformOrigin: 'left', duration: 0.6, delay: 0.4, ease: 'power2.out',
      });

      // Body content reveals — each element fades in as it enters viewport
      const els = document.querySelectorAll('.article-body h2, .article-body p, .article-body blockquote, .article-body ul, .article-body ol');
      els.forEach((el) => {
        (gsap as any).from(el, {
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            once: true,
          },
          y: 24, opacity: 0, duration: 0.65, ease: 'power2.out',
        });
      });

      // Ref card
      (gsap as any).from('.ref-card', {
        scrollTrigger: { trigger: '.ref-card', start: 'top 95%', once: true },
        y: 16, opacity: 0, duration: 0.5, ease: 'power2.out',
      });
    };
    document.head.appendChild(stScript);
  };
  document.head.appendChild(script);
</script>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: 72px var(--space-8) 96px;
  }

  /* Back link */
  .article-back {
    margin-bottom: 48px;
  }
  .back-link {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color var(--duration-fast) var(--ease-out);
    border-bottom: none;
  }
  .back-link:hover {
    color: var(--ink);
  }
  .back-arrow {
    font-style: normal;
  }

  /* Header */
  .article-header {
    margin-bottom: 48px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .article-title {
    font-family: var(--display);
    font-size: clamp(34px, 5vw, 52px);
    font-style: italic;
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 20px;
  }

  .article-dek {
    font-size: 19px;
    line-height: 1.5;
    color: var(--muted);
    max-width: 56ch;
    margin: 0 0 32px;
  }

  .article-rule {
    height: 1px;
    background: var(--hairline);
    width: 100%;
  }

  /* Body */
  .prose {
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink);
  }

  /* Drop cap on first paragraph */
  .prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--display);
    font-size: 72px;
    line-height: 0.82;
    padding-right: 10px;
    padding-top: 4px;
    color: var(--ink);
    font-weight: 400;
  }

  .prose p {
    margin: 0 0 1.4em;
    max-width: 65ch;
  }

  .prose h2 {
    font-family: var(--display);
    font-size: clamp(24px, 3vw, 30px);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--ink);
    margin: 2.2em 0 0.6em;
  }

  .prose blockquote {
    margin: 2em 0;
    padding: 0 0 0 24px;
    border-left: 3px solid var(--ink);
    font-size: 21px;
    line-height: 1.55;
    font-style: italic;
    color: var(--ink);
  }

  .prose blockquote p {
    margin: 0;
  }

  .prose ul, .prose ol {
    margin: 0 0 1.4em 1.4em;
    padding: 0;
  }

  .prose li {
    margin-bottom: 0.4em;
  }

  .prose a {
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .prose a:hover {
    border-color: var(--ink);
  }

  .prose strong {
    font-weight: 600;
  }

  /* Ref card */
  .ref-card {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .ref-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ref-link {
    font-family: var(--display);
    font-size: 18px;
    font-style: italic;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .ref-link:hover {
    border-color: var(--ink);
  }

  @media (max-width: 640px) {
    .article {
      padding: 48px var(--space-6) 64px;
    }
    .ref-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .prose > p:first-of-type::first-letter {
      font-size: 56px;
    }
  }
</style>
